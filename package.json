{
  "name": "modernschools-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation publique ModernSchools — docs.modernschools.online",
  "scripts": {
    "start": "docusaurus start",
    "build": "npm run validate && docusaurus build && pagefind --site build --output-subdir pagefind && node tools/postbuild.mjs",
    "serve": "docusaurus serve",
    "validate": "node tools/validate.mjs",
    "images": "python3 tools/images.py",
    "typecheck": "node tools/validate.mjs && tsc --noEmit",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/plugin-client-redirects": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "@docusaurus/tsconfig": "3.8.1",
    "@docusaurus/types": "3.8.1",
    "pagefind": "^1.3.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "webpack": "5.99.9"
  }
}
