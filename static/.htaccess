# docs.modernschools.online — Apache 2.4 (mod_rewrite, mod_headers, mod_expires).
# Site statique Docusaurus construit avec trailingSlash: false :
# /students/photos est servi par students/photos.html.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html

RewriteEngine On

# HTTPS et nom canonique
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://docs.modernschools.online%{REQUEST_URI} [R=301,L]

# Barre oblique finale → adresse sans barre (sauf racines)
RewriteCond %{REQUEST_URI} !^/(en/)?$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /chemin → /chemin.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# /en → /en/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Pages introuvables, par langue (statut 404 conservé)
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404.html
</If>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # YouTube en mode confidentialité renforcée, chargé au clic seulement.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.youtube-nocookie.com; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Index de recherche : noms de fichiers sans empreinte (pagefind.js, pagefind-ui.js…)
  # et index renommés à chaque construction : toujours revalider.
  <If "%{REQUEST_URI} =~ m#^/pagefind/#">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

AddType application/wasm .wasm
AddType video/mp4 .mp4
AddType text/vtt .vtt
